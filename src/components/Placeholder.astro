---
// A plain page: one heading, one lead line, then whatever the page passes in.
// Pages that a later milestone builds also pass "milestone" and get a "not open yet" line.
interface Props {
  title: string;
  lead?: string;
  milestone?: string;
}

const { title, lead, milestone } = Astro.props;
---

<section class="section" aria-labelledby="page-h">
  <div class="wrap">
    <div class="section-head">
      <h1 id="page-h">{title}</h1>
      {lead && <p>{lead}</p>}
    </div>
    <div class="stack-4">
      <slot />
      {milestone && <p class="t-small muted">This page is not open yet.{import.meta.env.DEV && ` (Planned for milestone ${milestone}; this note shows in the dev server only.)`}</p>}
    </div>
  </div>
</section>
