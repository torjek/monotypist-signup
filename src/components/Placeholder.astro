---
// Stand-in for a page that a later milestone builds.
interface Props {
  title: string;
  milestone?: string;
}

const { title, milestone } = Astro.props;
---

<section class="container placeholder">
  <h1>{title}</h1>
  <p class="lead"><slot /></p>
  {milestone && <p class="note">This page is not built yet. It is planned for milestone {milestone}.</p>}
</section>

<style>
  .placeholder {
    padding-block: var(--space-6);
  }

  h1 {
    font-size: var(--text-xl);
  }

  .lead {
    max-width: 40rem;
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
  }

  .note {
    display: inline-block;
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--color-line);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
</style>
