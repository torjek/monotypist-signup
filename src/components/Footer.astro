---
// The close (one line, one big button) and the footer columns, as the design kit's "close-type" and
// "footer-columns". The columns repeat the nav words.
import Logo from './Logo.astro';
import { footerNav, legalNav, mainAction, link } from '../data/site';

interface Props {
  home: boolean;
}

const { home } = Astro.props;
// A page that uses someone else's work under a licence names it here (the "credit" slot of Base.astro).
const credit = Astro.slots.has('credit') ? (await Astro.slots.render('credit')).trim() : '';
---

<footer class="footer closing" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">One email when ordering opens</h2>
      </div>
      <a class="btn btn--primary btn--xl btn--wide" href={link(mainAction.href, home)}>
        {mainAction.label}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg>
      </a>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-6 stack-4">
          <a class="nav__logo" href={home ? '#top' : '/'}><Logo /></a>
          <p class="footer__lede">One-handed keyboards, built to order.</p>
        </div>
        {
          footerNav.map((group) => (
            <div class="span-3 footer__col">
              <h3>{group.title}</h3>
              <ul>
                {group.links.map((item) => (
                  <li>
                    <a href={link(item.href, home)}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="footer__legal">
        <span>&copy; 2026 MonoTypist</span>
        <span class="footer__legal-links">{legalNav.map((item) => <a href={item.href}>{item.label}</a>)}</span>
      </div>
      {credit && <p class="footer__credit" set:html={credit} />}
    </div>
  </div>
</footer>

<!-- The legal links: one row on a wide screen; on a phone four columns, so the third starts on the same line as the column above. -->
<style is:inline>
  .footer__legal-links { display: flex; flex-wrap: wrap; gap: 0 var(--s-5); }
  .footer__credit { margin-top: var(--s-3); font-size: var(--t-label); color: var(--muted); }
  .footer__credit a { text-decoration: underline; text-underline-offset: 3px; }
  /* Two link columns, where the kit expects four: on a tablet each takes half the row. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .footer .footer__col { grid-column: auto / span 6; }
  }
  @media (max-width: 639px) {
    /* A few pixels less between the logo and the columns, so the footer is one phone screen. */
    .closing__links > .grid { row-gap: var(--s-4); }
    .footer__legal-links { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gutter); width: 100%; }
  }
</style>
