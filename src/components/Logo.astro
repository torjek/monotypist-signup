---
// The logo file is an alpha mask, so the logo takes the text colour of whatever it sits in.
// Its CSS (.logo) is in the page CSS block of src/layouts/Base.astro.
import wordmark from '../assets/logo-wordmark.webp';

const vars = `--logo-src:url(${wordmark.src});--logo-ratio:${wordmark.width}/${wordmark.height}`;
---

<span class="logo" role="img" aria-label="MonoTypist" style={vars}></span>
