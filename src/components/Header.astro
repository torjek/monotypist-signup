---
// The fixed bar. Markup and classes are the design kit's (public/assets/system.css, "nav-cards");
// system.js adds the phone menu, so there is no script here.
import Logo from './Logo.astro';
import { mainNav, keyboardMenu, mainAction, link } from '../data/site';

interface Props {
  home: boolean;
}

const { home } = Astro.props;
---

<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href={home ? '#top' : '/'}><Logo /></a>
    <nav class="nav__links" aria-label="Main">
      {
        mainNav.map((item, i) => (
          <div class="nav__item">
            <a class="nav__link" href={link(item.href, home)}>
              {item.label}
              {i === 0 && (
                <svg class="chev" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
            {i === 0 && (
              <div class="nav__menu">
                <div class="wrap grid">
                  {keyboardMenu.map((card) => (
                    <a class="menu-card span-4" href={link(card.href, home)}>
                      <div class="panel">
                        <img class="frame__img" src={card.image} alt={card.alt} width="820" height="400" loading="lazy" decoding="async" />
                      </div>
                      <span class="t-card">{card.label}</span>
                      <span class="t-small muted">{card.line}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))
      }
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={link(mainAction.href, home)}>{mainAction.label}</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</header>
